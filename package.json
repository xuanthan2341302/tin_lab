{
  "name": "tin-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:node": "tsx server.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "start": "NODE_ENV=production node server.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:migrate:neon": "node scripts/run-neon-migration.mjs",
    "test:worker": "tsx scripts/verify-worker-e2e.mjs",
    "test:load": "node scripts/load-test-worker.mjs",
    "lint": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google-cloud/storage": "^9.0.0",
    "@google/genai": "^3.4.0",
    "@neondatabase/serverless": "^1.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "latest",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.15.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "jose": "^6.2.18",
    "jszip": "^3.10.2",
    "lucide-react": "^1.74.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.168.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
