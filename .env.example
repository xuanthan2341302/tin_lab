# Server port (Google Cloud Run injects PORT automatically; defaults to 3000 locally)
PORT=3000

# Public canonical base URL (optional override for custom domain deployments)
PUBLIC_URL=https://ais-pre-fra34bcjqzk4pbluowypxl-385969079523.asia-east1.run.app

# Gemini API key (server-side only, used for Document AI Agent & essay grading)
GEMINI_API_KEY=

# Neon PostgreSQL connection string (used by Cloudflare Workers & Neon migration CLI)
DATABASE_URL=

# Firebase Project ID used to verify Google/Firebase ID Tokens via JWKS
FIREBASE_PROJECT_ID=gen-lang-client-0046593083

# Required secret (>= 32 random chars) used to seal published exam answer keys on the server (AES-256-GCM)
EXAM_SEALING_SECRET=

# SMTP Email Configuration for POST /api/contact
# Required for real email delivery (e.g., Gmail App Password, Resend SMTP, SendGrid SMTP, Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=sunghiep.tsbd@gmail.com

# Google Drive API Storage (replaces S3/R2/GCS Object Storage)
# Uses Google OAuth 2.0 (scope: https://www.googleapis.com/auth/drive.file) via firebase-applet-config.json
# Primary Super Admin My Drive account owning "TIN LAB - THƯ VIỆN TÀI LIỆU":
DRIVE_STORAGE_ACCOUNT_EMAIL=sunghiep.tsbd@gmail.com
